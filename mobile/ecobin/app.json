{
  "expo": {
    "name": "EcoBin",
    "slug": "EcoBin",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/EcoBinLogoGrande.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/EcoBinLogoGrande.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cauaboletiniremelli.EcoBin",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "EcoBin precisa acessar sua localização para centralizar o mapa na sua posição atual e facilitar o cadastro de sensores.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "development",
        "com.apple.security.application-groups": [
          "group.${ios.bundleIdentifier}.onesignal"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/EcoBinLogoGrande.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.cauaboletiniremelli.EcoBin",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/EcoBinLogoGrande.png"
    },
    "extra": {
      "eas": {
        "projectId": "e42cfa80-11e8-4ee4-ad76-434e904a68fb"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "EcoBin precisa acessar sua localização para centralizar o mapa na sua posição atual e facilitar o cadastro de sensores."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ]
    ]
  }
}
