{
  "expo": {
    "name": "EcoBin",
    "slug": "EcoBin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/EcoBinLogoVerdeCompleta.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/EcoBinLogoVerdeCompleta.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "EcoBin precisa acessar sua localização para centralizar o mapa na sua posição atual e facilitar o cadastro de sensores."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyAGBDlYaVucyTPfhfCqCULtygucsQDMBBQ"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/EcoBinLogoVerdeCompleta.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDJQDMCJjoNsBBoEPp7qb_CQ2scAr6SE1g"
        }
      }
    },
    "web": {
      "favicon": "./assets/EcoBinLogoVerdeCompleta.png"
    },
    "plugins": [
      "expo-barcode-scanner",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "EcoBin precisa acessar sua localização para centralizar o mapa na sua posição atual e facilitar o cadastro de sensores."
        }
      ]
    ]
  }
}
